# Which provider to talk to: openrouter or groq
AI_PROVIDER=openrouter

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq - https://console.groq.com/keys (only needed if AI_PROVIDER=groq)
GROQ_API_KEY=

# Optional overrides
# AI_MODEL defaults to meta-llama/llama-3.3-70b-instruct on OpenRouter,
# or llama-3.3-70b-versatile on Groq.
# AI_MODEL=meta-llama/llama-3.3-70b-instruct
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
